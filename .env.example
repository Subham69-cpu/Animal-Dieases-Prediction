# Flask / security
SECRET_KEY=change-me-to-long-random-string
JWT_SECRET=another-long-random-string
JWT_EXPIRE_HOURS=24
FLASK_DEBUG=false
PORT=5000

# MongoDB (Docker Compose default)
MONGO_URI=mongodb://mongo:27017/vet_healthcare
MONGO_DB_NAME=vet_healthcare

# If MongoDB is down: use local SQLite (default true). Set false to require Mongo only.
USE_SQLITE_FALLBACK=true
SQLITE_PATH=./data/vet_local.db

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model paths (defaults work for repo layout)
# CNN_MODEL_PATH=./cnn_model/model.h5
# ML_MODEL_DIR=./ml_model
# DATASET_ROOT=./dataset

# Admin bootstrap (optional — creates first admin on startup if unset in DB)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword

# Email (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Logging
LOG_LEVEL=INFO

# Frontend build (Render / static host)
VITE_API_URL=http://localhost:5000
